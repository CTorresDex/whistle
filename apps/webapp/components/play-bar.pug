include ../services/player.pug
include ../services/playlist.pug

play-bar
    | Play bar fixed at the bottom, hidden if  `player.status == stopped`
    flex.vertical
        .buttons
            button(icon="previous", (click)=playlist.previous())
            if player.status == "paused"
                button(icon="play", (click)=player.resume())
            else
                button(icon="pause", (click)=player.pause())
            button(icon="next", (click)=playlist.next())
        
        labels
            .left
                title {player.title}
            .right
                span {player.current-time} - {player.duration}
        .bottom
            progress-bar
    