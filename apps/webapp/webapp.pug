stack
    lang React
    engine NextJS
    framework TailwindsCSS

page#landing(route="/")
    if isUserLoggedIn
        - redirect("/home")
    else
        - redirect("/login")

page#login
    form(endpoint="/login")
        input#username
        input#password
        button.submit Iniciar sesión
    
    span(redirect-to="/signup") ¿No tienes cuenta? Registrate

page#signup
    form(endpoint="/signup")
        input#username
        input#password
        button.submit Registrarme

page#home(src="./pages/home.pug")